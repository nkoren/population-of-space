{
  "name": "population-of-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "validate": "tsx scripts/build-data.ts --check",
    "dev": "npm run data && vite",
    "build": "npm run data && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "start": "sirv dist --port ${PORT:-3000} --host 0.0.0.0 --single --maxage 3600 --immutable --gzip"
  },
  "dependencies": {
    "sirv-cli": "^3.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/d3-array": "^3.2.1",
    "@types/d3-format": "^3.0.4",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "js-yaml": "^4.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "zod": "^3.23.0"
  }
}
